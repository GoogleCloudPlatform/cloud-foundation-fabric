{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NVA Configuration",
  "description": "Schema for an NVA YAML file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "region"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "auto_instance_config": {
      "$ref": "#/$defs/auto_instance_config"
    },
    "ilb_config": {
      "$ref": "#/$defs/ilb_config"
    },
    "instance_groups": {
      "type": "object",
      "additionalProperties": false,
      "description": "Instance groups keyed by zone letter, used when `ilb_config.instance_groups` is not set.",
      "patternProperties": {
        "^[a-z]$": {
          "$ref": "#/$defs/instance_group"
        }
      }
    },
    "ncc_ra_config": {
      "$ref": "#/$defs/ncc_ra_config"
    },
    "bgp_config": {
      "$ref": "#/$defs/bgp_config"
    }
  },
  "$defs": {
    "auto_instance_config": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "instance_type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nic"
          }
        },
        "metadata": {
          "type": "object"
        },
        "confidential_compute": {
          "type": "boolean"
        },
        "encryption": {
          "type": "object"
        },
        "options": {
          "type": "object"
        },
        "shielded_config": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "nic": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string"
        },
        "subnet": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "masquerade": {
          "type": "boolean"
        },
        "masquerade_exclude": {
          "type": "array",
          "description": "Destination ranges excluded from masquerading (e.g. RFC1918).",
          "items": {
            "type": "string"
          }
        },
        "bgp_inbound_deny": {
          "type": "array",
          "description": "Prefixes rejected when received from the BGP neighbors on this NIC (exact match), only used by the BGP startup template.",
          "items": {
            "type": "string"
          }
        },
        "advertise": {
          "type": "array",
          "description": "Prefixes originated by the guest BGP daemon toward all its neighbors; each must be covered by a static route in `routes` on this NIC, since originated prefixes are not installed in the kernel. Only used by the BGP startup template.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "network",
        "subnet"
      ],
      "additionalProperties": false
    },
    "ilb_config": {
      "type": "object",
      "properties": {
        "connection_tracking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle_timeout_sec": {
              "type": "number"
            },
            "persist_conn_on_unhealthy": {
              "type": "string",
              "enum": [
                "DEFAULT_FOR_PROTOCOL",
                "NEVER_PERSIST",
                "ALWAYS_PERSIST"
              ]
            },
            "track_per_session": {
              "type": "boolean"
            }
          }
        },
        "health_check": {
          "type": "object"
        },
        "instance_groups": {
          "type": "object",
          "patternProperties": {
            "^[a-z]$": {
              "$ref": "#/$defs/instance_group"
            }
          }
        },
        "forwarding_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forwarding_rule"
          }
        },
        "session_affinity": {
          "type": "string",
          "enum": [
            "NONE",
            "CLIENT_IP",
            "CLIENT_IP_NO_DESTINATION",
            "CLIENT_IP_PORT_PROTO",
            "CLIENT_IP_PROTO"
          ]
        }
      }
    },
    "instance_group": {
      "type": "object",
      "properties": {
        "auto_create_instances": {
          "type": "number"
        },
        "attach_instances": {
          "type": "object"
        }
      }
    },
    "forwarding_rule": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string"
        },
        "subnet": {
          "type": "string"
        }
      },
      "required": [
        "network",
        "subnet"
      ]
    },
    "ncc_ra_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spokes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "hub"
            ],
            "properties": {
              "network": {
                "type": "string"
              },
              "hub": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "site_to_site_data_transfer": {
                "type": "boolean"
              },
              "instances": {
                "type": "array",
                "description": "Additional instances not created by the factory; `vm` and `ip` accept `$nva_instances:` and `$nva_addresses:` tokens.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "vm",
                    "ip"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Stable key used in peer names, defaults to the instance name."
                    },
                    "vm": {
                      "type": "string"
                    },
                    "ip": {
                      "type": "string"
                    }
                  }
                }
              },
              "include_import_ranges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude_import_ranges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "bgp_config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Guest FRR BGP configuration for auto-created instances; neighbors are derived from router peers that reference this NVA.",
      "required": [
        "asn"
      ],
      "properties": {
        "asn": {
          "type": "number"
        },
        "keepalive": {
          "type": "number"
        },
        "holdtime": {
          "type": "number"
        },
        "frr_image": {
          "type": "string"
        }
      }
    }
  }
}
