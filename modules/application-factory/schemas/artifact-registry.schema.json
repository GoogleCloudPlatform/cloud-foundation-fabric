{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "location"
  ],
  "properties": {
    "cleanup_policies": {
      "description": "Object containing details about the cleanup policies for an Artifact Registry repository.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tag_state": {
                "type": "string"
              },
              "tag_prefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "older_than": {
                "type": "string"
              },
              "newer_than": {
                "type": "string"
              },
              "package_name_prefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "version_name_prefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "most_recent_versions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package_name_prefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keep_count": {
                "type": "number"
              }
            }
          }
        },
        "required": [
          "action"
        ]
      }
    },
    "cleanup_policy_dry_run": {
      "description": "If true, the cleanup pipeline is prevented from deleting versions in this repository.",
      "type": "boolean"
    },
    "description": {
      "description": "An optional description for the repository.",
      "type": "string"
    },
    "enable_vulnerability_scanning": {
      "description": "Whether vulnerability scanning should be enabled in the repository.",
      "type": "boolean"
    },
    "encryption_key": {
      "description": "The KMS key name to use for encryption at rest.",
      "type": "string"
    },
    "format": {
      "description": "Repository format.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              },
              "required": [
                "public_repository"
              ]
            },
            "standard": {
              "type": "boolean"
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_repository": {
                  "type": "string"
                },
                "common_repository": {
                  "type": "string"
                },
                "custom_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              }
            },
            "standard": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "immutable_tags": {
                  "type": "boolean"
                }
              }
            },
            "virtual": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "number"
                  }
                },
                "required": [
                  "repository",
                  "priority"
                ]
              }
            }
          }
        },
        "kfp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standard": {
              "type": "boolean"
            }
          }
        },
        "generic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standard": {
              "type": "boolean"
            }
          }
        },
        "go": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "common_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              }
            },
            "standard": {
              "type": "boolean"
            }
          }
        },
        "googet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standard": {
              "type": "boolean"
            }
          }
        },
        "maven": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_repository": {
                  "type": "string"
                },
                "common_repository": {
                  "type": "string"
                },
                "custom_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              }
            },
            "standard": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allow_snapshot_overwrites": {
                  "type": "boolean"
                },
                "version_policy": {
                  "type": "string"
                }
              }
            },
            "virtual": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "number"
                  }
                },
                "required": [
                  "repository",
                  "priority"
                ]
              }
            }
          }
        },
        "npm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_repository": {
                  "type": "string"
                },
                "common_repository": {
                  "type": "string"
                },
                "custom_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              }
            },
            "standard": {
              "type": "boolean"
            },
            "virtual": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "number"
                  }
                },
                "required": [
                  "repository",
                  "priority"
                ]
              }
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_repository": {
                  "type": "string"
                },
                "common_repository": {
                  "type": "string"
                },
                "custom_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              }
            },
            "standard": {
              "type": "boolean"
            },
            "virtual": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "number"
                  }
                },
                "required": [
                  "repository",
                  "priority"
                ]
              }
            }
          }
        },
        "yum": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_repository": {
                  "type": "string"
                },
                "disable_upstream_validation": {
                  "type": "boolean"
                },
                "upstream_credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password_secret_version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "password_secret_version"
                  ]
                }
              },
              "required": [
                "public_repository"
              ]
            },
            "standard": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "iam": {
      "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "description": "Authoritative IAM bindings in {KEY => {role = ROLE, members = [], condition = {}}}. Keys are arbitrary.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "members",
          "role"
        ]
      }
    },
    "iam_bindings_additive": {
      "description": "Individual additive IAM bindings. Keys are arbitrary.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "member": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "member",
          "role"
        ]
      }
    },
    "iam_by_principals": {
      "description": "Authoritative IAM binding in {PRINCIPAL => [ROLES]} format. Principals need to be statically defined to avoid cycle errors. Merged internally with the `iam` variable.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "labels": {
      "description": "Labels to be attached to the registry.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "location": {
      "description": "Registry location. Use `gcloud beta artifacts locations list' to get valid values.",
      "type": "string"
    },
    "name": {
      "description": "Override resource name derived from filename.",
      "type": "string"
    },
    "project_id": {
      "description": "Registry project id.",
      "type": "string"
    },
    "tag_bindings": {
      "description": "Tag bindings for this repository, in key => tag value id format.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
