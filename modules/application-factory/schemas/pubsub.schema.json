{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pub/Sub Topic",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "iam": {
      "description": "IAM bindings for topic in {ROLE => [MEMBERS]} format.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "description": "Authoritative IAM bindings in {KEY => {role = ROLE, members = [], condition = {}}}. Keys are arbitrary.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "members",
          "role"
        ]
      }
    },
    "iam_bindings_additive": {
      "description": "Keyring individual additive IAM bindings. Keys are arbitrary.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "member": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "member",
          "role"
        ]
      }
    },
    "iam_by_principals": {
      "description": "Authoritative IAM binding in {PRINCIPAL => [ROLES]} format. Principals need to be statically defined to avoid cycle errors. Merged internally with the `iam` variable.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "kms_key": {
      "description": "KMS customer managed encryption key.",
      "type": "string"
    },
    "labels": {
      "description": "Labels.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "message_retention_duration": {
      "description": "Minimum duration to retain a message after it is published to the topic.",
      "type": "string"
    },
    "message_storage_enforce_in_transit": {
      "description": "If true, var.regions is also used to enforce in-transit guarantees for messages.",
      "type": "boolean"
    },
    "name": {
      "description": "Override resource name derived from filename.",
      "type": "string"
    },
    "project_id": {
      "description": "Project used for resources.",
      "type": "string"
    },
    "regions": {
      "description": "List of regions used to set persistence policy.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema": {
      "description": "Topic schema. If set, all messages in this topic should follow this schema.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {
          "type": "string"
        },
        "msg_encoding": {
          "type": "string"
        },
        "schema_type": {
          "type": "string"
        }
      },
      "required": [
        "definition",
        "schema_type"
      ]
    },
    "subscriptions": {
      "description": "Topic subscriptions. Also define push configs for push subscriptions. If options is set to null subscription defaults will be used. Labels default to topic labels if set to null.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ack_deadline_seconds": {
            "type": "number"
          },
          "enable_exactly_once_delivery": {
            "type": "boolean"
          },
          "enable_message_ordering": {
            "type": "boolean"
          },
          "expiration_policy_ttl": {
            "type": "string"
          },
          "filter": {
            "type": "string"
          },
          "iam": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "message_retention_duration": {
            "type": "string"
          },
          "retain_acked_messages": {
            "type": "boolean"
          },
          "bigquery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "table": {
                "type": "string"
              },
              "drop_unknown_fields": {
                "type": "boolean"
              },
              "service_account_email": {
                "type": "string"
              },
              "use_table_schema": {
                "type": "boolean"
              },
              "use_topic_schema": {
                "type": "boolean"
              },
              "write_metadata": {
                "type": "boolean"
              }
            },
            "required": [
              "table"
            ]
          },
          "cloud_storage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bucket": {
                "type": "string"
              },
              "filename_prefix": {
                "type": "string"
              },
              "filename_suffix": {
                "type": "string"
              },
              "max_duration": {
                "type": "string"
              },
              "max_bytes": {
                "type": "number"
              },
              "avro_config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "write_metadata": {
                    "type": "boolean"
                  }
                }
              }
            },
            "required": [
              "bucket"
            ]
          },
          "dead_letter_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string"
              },
              "max_delivery_attempts": {
                "type": "number"
              }
            },
            "required": [
              "topic"
            ]
          },
          "iam_bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "type": "string"
                },
                "condition": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "expression": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "expression",
                    "title"
                  ]
                }
              },
              "required": [
                "members",
                "role"
              ]
            }
          },
          "iam_bindings_additive": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "member": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "condition": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "expression": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "expression",
                    "title"
                  ]
                }
              },
              "required": [
                "member",
                "role"
              ]
            }
          },
          "push": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "type": "string"
              },
              "attributes": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "no_wrapper": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "write_metadata": {
                    "type": "boolean"
                  }
                }
              },
              "oidc_token": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "audience": {
                    "type": "string"
                  },
                  "service_account_email": {
                    "type": "string"
                  }
                },
                "required": [
                  "service_account_email"
                ]
              }
            },
            "required": [
              "endpoint"
            ]
          },
          "retry_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum_backoff": {
                "type": "number"
              },
              "maximum_backoff": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
