{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service Account",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "create_ignore_already_exists": {
      "description": "If set to true, skip service account creation if a service account with the same email already exists.",
      "type": "boolean"
    },
    "deletion_policy": {
      "description": "Deletion policy: DELETE, ABANDON, or PREVENT.",
      "type": "string"
    },
    "description": {
      "description": "Optional description.",
      "type": "string"
    },
    "display_name": {
      "description": "Display name of the service account to create.",
      "type": "string"
    },
    "iam": {
      "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
      "$ref": "#/$defs/iam"
    },
    "iam_billing_bindings": {
      "description": "Billing account role bindings granted to this service account, by arbitrary key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "billing_account_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "billing_account_id",
          "role"
        ]
      }
    },
    "iam_billing_roles": {
      "description": "Billing account roles granted to this service account, by billing account id. Non-authoritative.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "description": "Authoritative IAM bindings in {KEY => {role = ROLE, members = [], condition = {}}}. Keys are arbitrary.",
      "$ref": "#/$defs/iam_bindings"
    },
    "iam_bindings_additive": {
      "description": "Individual additive IAM bindings. Keys are arbitrary.",
      "$ref": "#/$defs/iam_bindings_additive"
    },
    "iam_by_principals": {
      "description": "Authoritative IAM binding in {PRINCIPAL => [ROLES]} format. Principals need to be statically defined to avoid errors. Merged internally with the `iam` variable.",
      "$ref": "#/$defs/iam_by_principals"
    },
    "iam_by_principals_additive": {
      "description": "Additive IAM binding in {PRINCIPAL => [ROLES]} format. Principals need to be statically defined to avoid errors. Merged internally with the `iam_bindings_additive` variable.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_folder_bindings": {
      "description": "Folder role bindings granted to this service account, by arbitrary key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "folder_id",
          "role"
        ]
      }
    },
    "iam_folder_roles": {
      "description": "Folder roles granted to this service account, by folder id. Non-authoritative.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_organization_bindings": {
      "description": "Organization role bindings granted to this service account, by arbitrary key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organization_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "organization_id",
          "role"
        ]
      }
    },
    "iam_organization_roles": {
      "description": "Organization roles granted to this service account, by organization id. Non-authoritative.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_project_bindings": {
      "description": "Project role bindings granted to this service account, by arbitrary key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "project_id",
          "role"
        ]
      }
    },
    "iam_project_roles": {
      "description": "Project roles granted to this service account, by project id.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_sa_bindings": {
      "description": "Service account role bindings granted to this service account, by arbitrary key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "service_account_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "service_account_id",
          "role"
        ]
      }
    },
    "iam_sa_roles": {
      "description": "Service account roles granted to this service account, by service account name.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_storage_bindings": {
      "description": "Storage role bindings granted to this service account, by arbitrary key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "expression",
              "title"
            ]
          }
        },
        "required": [
          "bucket",
          "role"
        ]
      }
    },
    "iam_storage_roles": {
      "description": "Storage roles granted to this service account, by bucket name.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "name": {
      "description": "Override resource name derived from filename.",
      "type": "string"
    },
    "prefix": {
      "description": "Prefix applied to service account names.",
      "type": "string"
    },
    "project_id": {
      "description": "Project id where service account will be created. This can be left null when reusing service accounts.",
      "type": "string"
    },
    "tag_bindings": {
      "description": "Tag bindings for this service accounts, in key => tag value id format.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "iam": {
      "type": "object",
      "description": "IAM bindings in {ROLE => [MEMBERS]} format.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "iam_bindings": {
      "type": "object",
      "description": "Authoritative IAM bindings.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "members",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "required": [
              "expression",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "iam_bindings_additive": {
      "type": "object",
      "description": "Individual additive IAM bindings.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "member",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "member": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "condition": {
            "type": "object",
            "required": [
              "expression",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "iam_by_principals": {
      "type": "object",
      "description": "IAM binding in {PRINCIPAL => [ROLES]} format.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
